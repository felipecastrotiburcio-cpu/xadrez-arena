# Copie para .env e ajuste. Em produção NUNCA versione o .env.

# development | production
NODE_ENV=development
PORT=3001

# ---------------------------------------------------------------- JWT
# Obrigatório em produção (mínimo 32 caracteres). Gere com:
#   openssl rand -base64 48
# Em desenvolvimento, se vazio, um segredo aleatório é criado em data/.jwt-secret.
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_ISSUER=xadrez-arena
JWT_AUDIENCE=xadrez-arena-app

# ---------------------------------------------------------------- HTTPS
# Opção A (recomendada): proxy reverso com HTTPS (Caddy/Nginx) na frente.
#   TRUST_PROXY=1 faz o servidor confiar no X-Forwarded-Proto do proxy.
TRUST_PROXY=
# Opção B: TLS direto no Node.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Com a opção B, uma porta HTTP que só redireciona para HTTPS (ex: 80).
HTTP_REDIRECT_PORT=
# Domínio público usado nos redirecionamentos HTTP -> HTTPS.
PUBLIC_HOST=
# Padrão: true em produção.
FORCE_HTTPS=

# Origens liberadas no navegador (versão web), separadas por vírgula.
# Os apps iOS/Android não dependem disso.
CORS_ORIGINS=
